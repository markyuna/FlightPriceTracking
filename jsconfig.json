{
    "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "target": "ES2020",
      "jsx": "react-jsx",
      "checkJs": true,
      "strictNullChecks": true,
      "strictFunctionTypes": true,
      "resolveJsonModule": true
    },
    "exclude": ["node_modules", "**/node_modules/*"]
  }